<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SonyPodsWin.Views.SonySmartPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <ScrollViewer x:Name="PageScrollViewer" Padding="24" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Padding="0,0,4,12">
            <TextBlock Text="索尼智能控制" Style="{StaticResource PageTitleStyle}" />

            <!-- 两列 1:1 网格 -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左卡片：智能聆听与多点连接 -->
                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" VerticalAlignment="Top">
                    <StackPanel Spacing="12">
                        <TextBlock Text="智能聆听与多点连接" Style="{StaticResource CardTitleStyle}" />

                        <!-- 智能免摘对话 -->
                        <Grid MinHeight="60" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="智能免摘对话" Style="{StaticResource ControlTitleStyle}" />
                                <TextBlock Text="开口说话时自动暂停音乐并开启环境声" Style="{StaticResource CaptionCopyStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="SpeakToChatSwitch"
                                Grid.Column="1"
                                OnContent="开"
                                OffContent="关"
                                VerticalAlignment="Center"
                                Toggled="OnSpeakToChatToggled" />
                        </Grid>

                        <Border Style="{StaticResource SectionDividerStyle}" />

                        <!-- 同时连接 2 台设备 -->
                        <Grid MinHeight="60" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="同时连接 2 台设备" Style="{StaticResource ControlTitleStyle}" />
                                <TextBlock Text="开启蓝牙多点连接（通过通用设置槽位自动协商）" Style="{StaticResource CaptionCopyStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="MultipointSwitch"
                                Grid.Column="1"
                                OnContent="开"
                                OffContent="关"
                                VerticalAlignment="Center"
                                Toggled="OnMultipointToggled" />
                        </Grid>

                        <Border Style="{StaticResource SectionDividerStyle}" />

                        <!-- 影院声场模式 -->
                        <Grid MinHeight="60" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="影院声场模式" Style="{StaticResource ControlTitleStyle}" />
                                <TextBlock Text="增强影片观看时的空间环绕感" Style="{StaticResource CaptionCopyStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="CinemaModeSwitch"
                                Grid.Column="1"
                                OnContent="开"
                                OffContent="关"
                                VerticalAlignment="Center"
                                Toggled="OnCinemaModeToggled" />
                        </Grid>

                        <Border Style="{StaticResource SectionDividerStyle}" />

                        <!-- 已配对多点设备（只读金色标签） -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="已配对多点设备" Style="{StaticResource ControlTitleStyle}" />
                            <TextBlock
                                x:Name="PairedDevicesText"
                                Text="正在读取已配对设备..."
                                FontSize="13"
                                Foreground="{StaticResource AccentBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Style="{StaticResource SectionDividerStyle}" />

                        <!-- 自动关机策略（只读灰字标签） -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="自动关机策略" Style="{StaticResource ControlTitleStyle}" />
                            <TextBlock
                                x:Name="AutoPowerOffText"
                                Text="已启用佩戴检测自动关机"
                                Style="{StaticResource CaptionCopyStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 右卡片：耳机音量与电源管理 -->
                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" VerticalAlignment="Top">
                    <StackPanel Spacing="12">
                        <TextBlock Text="耳机音量与电源管理" Style="{StaticResource CardTitleStyle}" />

                        <!-- 耳机媒体音量（0-100，默认 50，松手下发） -->
                        <StackPanel Spacing="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="52" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="耳机媒体音量" Style="{StaticResource ControlTitleStyle}" VerticalAlignment="Center" />
                                <TextBlock
                                    x:Name="VolumeValueText"
                                    Grid.Column="1"
                                    Text="50%"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource AccentBrush}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center" />
                            </Grid>
                            <Slider
                                x:Name="HeadphoneVolumeSlider"
                                Minimum="0"
                                Maximum="100"
                                StepFrequency="1"
                                Value="50"
                                ValueChanged="OnVolumeSliderValueChanged"
                                PointerCaptureLost="OnVolumeSliderReleased" />
                        </StackPanel>

                        <Border Style="{StaticResource SectionDividerStyle}" />

                        <!-- 播放控制按钮行（走耳机协议 PlaybackControl） -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="耳机播放控制" Style="{StaticResource ControlTitleStyle}" />
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.15*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1.15*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="⏮ 上一曲" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" MinWidth="0" Padding="4,8" FontSize="12" Click="OnPrevTrackClicked" />
                                <Button Grid.Column="1" Content="▶ 播放" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" MinWidth="0" Padding="4,8" FontSize="12" Click="OnPlayClicked" />
                                <Button Grid.Column="2" Content="⏸ 暂停" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" MinWidth="0" Padding="4,8" FontSize="12" Click="OnPauseClicked" />
                                <Button Grid.Column="3" Content="⏭ 下一曲" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" MinWidth="0" Padding="4,8" FontSize="12" Click="OnNextTrackClicked" />
                            </Grid>
                        </StackPanel>

                        <Border Style="{StaticResource SectionDividerStyle}" />

                        <!-- 关闭耳机电源（红色描边危险按钮） -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="电源操作" Style="{StaticResource ControlTitleStyle}" />
                            <TextBlock Text="立即向已连接的索尼耳机发送关机指令，耳机将直接断连。" Style="{StaticResource CaptionCopyStyle}" TextWrapping="Wrap" />
                            <Button
                                x:Name="PowerOffButton"
                                Content="⏻ 关闭耳机电源"
                                Style="{StaticResource DangerButtonStyle}"
                                HorizontalAlignment="Left"
                                Click="OnPowerOffClicked" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
