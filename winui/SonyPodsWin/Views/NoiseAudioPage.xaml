<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SonyPodsWin.Views.NoiseAudioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SonyPodsWin.Controls"
    NavigationCacheMode="Required">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- A. 固定顶部设备信息区（高约 120px，Border + 6 列 Grid） -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" MinHeight="116">
            <Grid ColumnSpacing="16" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 列 0：头戴耳机图标 -->
                <Border
                    Grid.Column="0"
                    Width="56"
                    Height="56"
                    CornerRadius="28"
                    Background="{StaticResource SecondaryBackgroundBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1">
                    <FontIcon Glyph="&#xE7F6;" FontSize="26" Foreground="{StaticResource TextPrimaryBrush}" />
                </Border>

                <!-- 列 1：设备型号与连接状态 -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <TextBlock
                        x:Name="ModelNameText"
                        Text="WH-1000XM6"
                        Style="{StaticResource DeviceTitleStyle}"
                        TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource TextMutedBrush}" />
                        <TextBlock x:Name="StatusText" Text="未连接" Style="{StaticResource CaptionCopyStyle}" />
                    </StackPanel>
                </StackPanel>

                <!-- 列 2：电量环（直径 64px ProgressRing + 电量数字） -->
                <Grid Grid.Column="2" Width="64" Height="64" VerticalAlignment="Center">
                    <ProgressRing
                        x:Name="BatteryRing"
                        Width="64"
                        Height="64"
                        IsIndeterminate="False"
                        Minimum="0"
                        Maximum="100"
                        Value="0"
                        Foreground="{StaticResource AccentBrush}"
                        Background="{StaticResource SecondaryBackgroundBrush}" />
                    <TextBlock
                        x:Name="BatteryText"
                        Text="--%"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Grid>

                <!-- 列 3：音频编码 -->
                <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2" MinWidth="68">
                    <TextBlock Text="编码" Style="{StaticResource CaptionCopyStyle}" />
                    <TextBlock x:Name="CodecText" Text="--" Style="{StaticResource ControlTitleStyle}" FontSize="15" />
                </StackPanel>

                <!-- 列 4：固件版本 -->
                <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="2" MinWidth="68">
                    <TextBlock Text="固件版本" Style="{StaticResource CaptionCopyStyle}" />
                    <TextBlock x:Name="FirmwareText" Text="--" Style="{StaticResource ControlTitleStyle}" FontSize="15" />
                </StackPanel>

                <!-- 列 5：切换设备与连接/断开按钮 -->
                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button
                        x:Name="SwitchDeviceButton"
                        Content="切换设备 ▾"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="OnSwitchDeviceClicked" />
                    <Button
                        x:Name="ConnectButton"
                        Content="连接"
                        Style="{StaticResource AccentButtonStyle}"
                        MinWidth="96"
                        Click="OnConnectClicked" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 下方主内容滚动区 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" Padding="0,0,4,12">

                <!-- B. 降噪模式：水平三选（高 52px、均分宽度、选中香槟金底深字） -->
                <Border
                    Background="{StaticResource SecondaryBackgroundBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="4">
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button
                            x:Name="NcModeAncButton"
                            Grid.Column="0"
                            Height="52"
                            HorizontalAlignment="Stretch"
                            CornerRadius="6"
                            BorderThickness="0"
                            Click="OnNcModeAncClicked">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7F6;" FontSize="15" />
                                <TextBlock Text="降噪" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="NcModeAsmButton"
                            Grid.Column="1"
                            Height="52"
                            HorizontalAlignment="Stretch"
                            CornerRadius="6"
                            BorderThickness="0"
                            Click="OnNcModeAsmClicked">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE720;" FontSize="15" />
                                <TextBlock Text="环境声" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="NcModeOffButton"
                            Grid.Column="2"
                            Height="52"
                            HorizontalAlignment="Stretch"
                            CornerRadius="6"
                            BorderThickness="0"
                            Click="OnNcModeOffClicked">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE711;" FontSize="15" />
                                <TextBlock Text="关闭" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- C & D. 环境声音控制卡片 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="环境声音控制" Style="{StaticResource CardTitleStyle}" />

                        <!-- 环境声等级（1-20，松手下发，数值固定宽 52px） -->
                        <Grid MinHeight="64" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="环境声等级" Style="{StaticResource ControlTitleStyle}" />
                                <TextBlock Text="调节通透模式下的外部环境音传入强度（1 - 20）" Style="{StaticResource CaptionCopyStyle}" TextWrapping="Wrap" />
                            </StackPanel>

                            <TextBlock
                                x:Name="AmbientLevelText"
                                Grid.Column="1"
                                Text="15 级"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource AccentBrush}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center" />

                            <Slider
                                x:Name="AmbientLevelSlider"
                                Grid.Column="2"
                                Minimum="1"
                                Maximum="20"
                                StepFrequency="1"
                                Value="15"
                                VerticalAlignment="Center"
                                ValueChanged="OnAmbientSliderValueChanged"
                                PointerCaptureLost="OnAmbientSliderReleased" />
                        </Grid>

                        <Border Style="{StaticResource SectionDividerStyle}" />

                        <!-- 关注语音 -->
                        <Grid MinHeight="68" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="关注语音" Style="{StaticResource ControlTitleStyle}" />
                                <TextBlock Text="在环境声模式下抑制噪声并重点保留人声" Style="{StaticResource CaptionCopyStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="VoiceFocusSwitch"
                                Grid.Column="1"
                                OnContent="开"
                                OffContent="关"
                                VerticalAlignment="Center"
                                Toggled="OnVoiceFocusToggled" />
                        </Grid>

                        <Border Style="{StaticResource SectionDividerStyle}" />

                        <!-- 自适应环境声灵敏度 -->
                        <Grid MinHeight="68" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="自适应环境声灵敏度" Style="{StaticResource ControlTitleStyle}" />
                                <TextBlock Text="根据周围环境噪音自动调节环境声通透度" Style="{StaticResource CaptionCopyStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="AutoAmbientSwitch"
                                Grid.Column="1"
                                OnContent="开"
                                OffContent="关"
                                VerticalAlignment="Center"
                                Toggled="OnAutoAmbientToggled" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- E. 10 段均衡器与声音增强卡片（按规格使用原生 ComboBox 选预设） -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Text="10 段均衡器与声音增强"
                                Style="{StaticResource CardTitleStyle}"
                                VerticalAlignment="Center" />
                            <ComboBox
                                x:Name="EqPresetComboBox"
                                Grid.Column="1"
                                MinWidth="160"
                                SelectionChanged="OnEqPresetSelectionChanged" />
                        </Grid>

                        <controls:EqualizerControl x:Name="EqGraph" Height="210" />

                        <Border Style="{StaticResource SectionDividerStyle}" />

                        <!-- DSEE 音质提升开关 -->
                        <Grid MinHeight="60" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="DSEE 音质提升" Style="{StaticResource ControlTitleStyle}" />
                                <TextBlock Text="对压缩音源的高频细节进行实时补偿修复" Style="{StaticResource CaptionCopyStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="DseeSwitch"
                                Grid.Column="1"
                                OnContent="开"
                                OffContent="关"
                                VerticalAlignment="Center"
                                Toggled="OnDseeToggled" />
                        </Grid>

                        <Border Style="{StaticResource SectionDividerStyle}" />

                        <!-- 声音质量优先开关 -->
                        <Grid MinHeight="60" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="声音质量优先" Style="{StaticResource ControlTitleStyle}" />
                                <TextBlock Text="开启时优先高码率（如 LDAC），关闭时优先连接稳定性" Style="{StaticResource CaptionCopyStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="QualityPrioritySwitch"
                                Grid.Column="1"
                                OnContent="开"
                                OffContent="关"
                                VerticalAlignment="Center"
                                Toggled="OnQualityPriorityToggled" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
