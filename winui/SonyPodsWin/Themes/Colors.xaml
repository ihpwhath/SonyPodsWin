<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 深色 Fluent 颜色系统（按 design-winui-v1.md 规格键名定义，香槟金为唯一品牌强调色） -->
    <Color x:Key="AppBackground">#FF1E1F22</Color>
    <Color x:Key="MicaSurfaceColor">#FF25272B</Color>
    <Color x:Key="CardBackground">#FF2A2D32</Color>
    <Color x:Key="SecondaryBackground">#FF34373D</Color>
    <Color x:Key="BorderColor">#FF3A3D42</Color>

    <Color x:Key="AccentColor">#FFD4B16A</Color>
    <Color x:Key="AccentHoverColor">#FFE0C07F</Color>
    <Color x:Key="AccentPressedColor">#FFC19D55</Color>
    <Color x:Key="AccentTextOnColor">#FF1E1F22</Color>

    <Color x:Key="TextPrimary">#FFFFFFFF</Color>
    <Color x:Key="TextSecondary">#FFA9ADB3</Color>
    <Color x:Key="TextMuted">#FF6B7077</Color>

    <Color x:Key="SuccessColor">#FF55A66D</Color>
    <Color x:Key="ErrorColor">#FFD46B6B</Color>
</ResourceDictionary>
